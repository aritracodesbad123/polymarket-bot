# Paper focus: crypto | (empty = all)
UNIVERSE_TAG=crypto
UNIVERSE_TAGS=crypto,forex

# Pay-for-yourself regime (capital + estimated API burn)
REGIME_ENABLED=true
HOLDING_STOP_PCT=0.25
HOLDING_THESIS_EDGE=0.02
HOLDING_MAX_HOURS=48
ESTIMATED_USD_PER_AI_CALL=0.02
# Hard no-fill session cap (UTC-day burn). Not the DEFEND band.
AI_SESSION_BUDGET_USD=10
# After that cap (or the post-fill screening stop), keep screening with a
# non-LLM book estimator. Unset keeps the burn-stop: no new screening.
# Does not forecast the event. Survival gates are unchanged
# (MIN_EDGE, MAX_SPREAD, mid 10–90, Kelly 0.25, kill, weekly, caps).
# ESTIMATOR=microstructure
# When ESTIMATOR=microstructure, flip LLM↔micro on daily realized PnL vs burn
# (default ON). Set 0 for micro-after-stop only (no realized flip-back).
# ESTIMATOR_AUTO_SWITCH=1
# Fair = clip(mid + MICRO_LAMBDA * imbalance, 0.01, 0.99). Default λ is 0.08
# (Phase 1b: 8¢ at |I|=1, not capped at the half-spread). |I| below MICRO_MIN_ABS_I
# rejects as micro_weak_imbalance. Touch size under 3× the intended order
# rejects as micro_thin_touch. Mid in [MICRO_COIN_FLIP_MIN, MICRO_COIN_FLIP_MAX]
# (defaults 0.45–0.55 inclusive) rejects micro new entries as micro_coin_flip_mid.
# MICRO_LAMBDA=0.08
# MICRO_MIN_ABS_I=0.40
# MICRO_COIN_FLIP_MIN=0.45
# MICRO_COIN_FLIP_MAX=0.55
# Skip the AI estimate when the fresh book mid is outside this band.
# Edges are tradeable. Unset uses 0.10 and 0.90.
MIN_TRADEABLE_MID=0.10
MAX_TRADEABLE_MID=0.90
# DEFEND band only. 0 turns the band off. It is not the spend budget.
API_DIE_CUSHION_USD=0.50
DEFEND_EDGE_TIGHTEN=0.02
KILL_FLOOR_PCT=0.20

# Optional. Unset = percentage caps only. Cohort values belong on that env,
# not in this example. See docs/OPERATIONS.md ($5,000 cohort):
#   DB_PATH=polygrok-week2-5000.db
#   PAPER_STARTING_BANKROLL=5000
#   KILL_FLOOR_PCT=0.10          # catastrophic DIE at $4,500
#   AI_SESSION_BUDGET_USD=10     # no-fill DIE at $10 session burn
#   API_DIE_CUSHION_USD=0        # DEFEND band off; not the spend cap
#   WEEKLY_LOSS_PCT=0.05         # weekly halt/DIE at $4,750
#   MAX_POSITION_USD=25
#   MAX_TOTAL_EXPOSURE_USD=500
#   MAX_DAILY_LOSS_USD=50
# MAX_POSITION_USD=
# MAX_TOTAL_EXPOSURE_USD=
# MAX_DAILY_LOSS_USD=
# WEEKLY_LOSS_PCT=
