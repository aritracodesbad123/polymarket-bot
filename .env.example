# Paper focus: crypto | (empty = all)
UNIVERSE_TAG=crypto
UNIVERSE_TAGS=crypto,forex

# Pay-for-yourself regime (capital + estimated API burn)
REGIME_ENABLED=true
HOLDING_STOP_PCT=0.25
HOLDING_THESIS_EDGE=0.02
HOLDING_MAX_HOURS=48
ESTIMATED_USD_PER_AI_CALL=0.02
API_DIE_CUSHION_USD=0.50
DEFEND_EDGE_TIGHTEN=0.02
KILL_FLOOR_PCT=0.20

